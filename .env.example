# Copy to .env.local. Loaded by run_agent.py; never commit real credentials.
LINKDESK_PROVIDER=ark
LINKDESK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LINKDESK_MODEL=your-model-id
LINKDESK_API_KEY=
# OpenAI alternative:
# LINKDESK_PROVIDER=openai
# LINKDESK_BASE_URL=https://api.openai.com/v1
# LINKDESK_MODEL=gpt-4.1
# LINKDESK_API_KEY=
# Optional runtime settings (export in shell):
# LINKDESK_DATA=/path/to/private/workspace
# LINKDESK_BROWSER_CHANNEL=chrome
# Legacy workbench only (export in shell):
# RELATION_LLM_BASE_URL=https://your-provider.example/v1
# RELATION_LLM_MODEL=your-model-id
# RELATION_LLM_API_KEY=
